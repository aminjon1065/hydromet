# Application ---------------------------------------------------------------
APP_NAME="Hydromet portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Application locale keys are tj, ru and en. The fallback is ru.
# The internal tj key is mapped to tg / tg-TJ only at external boundaries.
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

# Timestamps are stored in UTC and displayed in the timezone below.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Dushanbe

# Content Security Policy. Public responses always carry a per-request nonce in
# script-src. This switch governs style-src only, and defaults to the
# browser-compatible policy; see config/security.php before turning it on.
CSP_STYLE_NONCE=false

# Public FMI forecast page embedded by the dedicated SILAM view.
# The frame policy for that page is derived from this origin, so it must be an
# absolute https URL. Anything else leaves the frame blocked by design.
SILAM_URL=https://silam.fmi.fi/roux/TAJ/

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# Logging -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database ------------------------------------------------------------------
# Matches the `postgres` service in compose.yaml (PostgreSQL with PostGIS).
# Replace the password with a strong value outside local development.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hydromet
DB_USERNAME=hydromet
DB_PASSWORD=hydromet_local_only

# Redis ---------------------------------------------------------------------
# predis is used so the container does not need the phpredis extension.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail ----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Docker Compose ------------------------------------------------------------
# Host ports published by compose.yaml.
APP_HTTP_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
