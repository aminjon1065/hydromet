{
    "printWidth": 100,
    "tabWidth": 4,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./resources/css/app.css",
    "tailwindFunctions": ["cn", "cva"],
    "overrides": [
        {
            "files": ["*.json", "*.yaml", "*.yml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
