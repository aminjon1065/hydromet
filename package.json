{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write resources/js resources/css tests/frontend vite.config.ts vitest.config.ts eslint.config.js",
        "format:check": "prettier --check resources/js resources/css tests/frontend vite.config.ts vitest.config.ts eslint.config.js",
        "types:check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@inertiajs/react": "^3.7.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.560.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    }
}
