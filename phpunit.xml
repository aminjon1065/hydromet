<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <!--
        The test environment is not declared here. An `<env>` entry only reaches
        $_ENV and putenv(), which lose to the process variables Compose injects
        from .env, so the suite silently ran on the application's own cache,
        session and database. tests/TestEnvironment.php applies those values
        instead, and documents how to point the run at PostgreSQL.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
</phpunit>
